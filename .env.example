# Firebase client-side configuration.
# These keys are safe to be public and are prefixed with NEXT_PUBLIC_.
#
# How to get these values:
# 1. Go to the Firebase Console: https://console.firebase.google.com/
# 2. Select your project (zilacart-6a1a8).
# 3. In the top-left, click the gear icon (Project settings).
# 4. Under "Your apps", find your web app and look for the "SDK setup and configuration" section.
# 5. Select "Config". You will see a `firebaseConfig` object.
# 6. Copy the corresponding values into your .env file.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google AI (Gemini) API Key for Genkit flows.
# This key should be kept secret and NOT prefixed with NEXT_PUBLIC_.
#
# How to get this value:
# 1. Go to Google AI Studio: https://aistudio.google.com/app/apikey
# 2. Click "Create API key".
# 3. Copy the key and paste it here.
GOOGLE_API_KEY=

# ── Server-side Firebase (Firebase Admin SDK) ──────────────────────────────
# Used at runtime by the app, WebSocket server and worker containers.
# FIREBASE_PRIVATE_KEY is a secret: it is injected at runtime only, never baked
# into Docker image layers. For emulator mode the *_EMULATOR_HOST vars below are
# enough and no service account is required.
FIREBASE_PROJECT_ID=zilacart-local
FIREBASE_CLIENT_EMAIL=emulator@example.com
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=zilacart-local.appspot.com

# Firebase Emulators (Docker stack hostnames).
FIRESTORE_EMULATOR_HOST=firebase-emulator:8080
FIREBASE_AUTH_EMULATOR_HOST=firebase-emulator:9099

# ── Payments ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ── AWS / LocalStack ────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
AWS_SQS_ENDPOINT=http://localstack:4566

# ── Observability ───────────────────────────────────────────────────────────
LOKI_URL=http://loki:3100
GRAFANA_ADMIN_PASSWORD=admin

# ── Identity (Keycloak - auth profile) ───────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_PASSWORD=admin

# ── Database (Postgres - full profile) ───────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
