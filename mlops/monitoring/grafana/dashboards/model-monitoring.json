{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "#000000",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Model monitoring dashboard: inference count and latency",
  "panels": [
    {
      "type": "graph",
      "title": "Model Inferences (per minute)",
      "id": 1,
      "targets": [
        {
          "expr": "rate(model_inferences_total[1m])",
          "legendFormat": "{{model_name}}",
          "refId": "A"
        }
      ],
      "interval": "",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0}
    },
    {
      "type": "graph",
      "title": "Model Inference P99 Latency (s)",
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(model_inference_latency_seconds_bucket[5m])) by (le, model_name, version))",
          "legendFormat": "{{model_name}}:{{version}}",
          "refId": "A"
        }
      ],
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8}
    }
  ],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "title": "Model Monitoring",
  "version": 1
}
