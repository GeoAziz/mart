{
  "annotations": {"list": []},
  "description": "Inference service metrics: errors and latency histogram",
  "panels": [
    {
      "type": "stat",
      "title": "Inference Errors (5m)",
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(model_inference_errors_total[5m]))",
          "refId": "A"
        }
      ],
      "gridPos": {"h": 4, "w": 12, "x": 0, "y": 0}
    },
    {
      "type": "graph",
      "title": "Inference Latency (p50/p95/p99)",
      "id": 2,
      "targets": [
        {"expr": "histogram_quantile(0.5, sum(rate(model_inference_latency_seconds_bucket[5m])) by (le, model_name))", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum(rate(model_inference_latency_seconds_bucket[5m])) by (le, model_name))", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum(rate(model_inference_latency_seconds_bucket[5m])) by (le, model_name))", "refId": "C"}
      ],
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 4}
    }
  ],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "title": "Inference Metrics",
  "version": 1
}
