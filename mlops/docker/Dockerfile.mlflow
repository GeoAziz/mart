FROM python:3.10-slim

WORKDIR /mlflow

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir mlflow==2.8.0

EXPOSE 5000

CMD ["mlflow", "server", "--backend-store-uri", "sqlite:////mlflow_backend/mlflow.db", "--default-artifact-root", "/mlflow_artifacts", "--host", "0.0.0.0", "--port", "5000"]