FROM python:3.14-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies with extended timeout for large packages
COPY requirements-mlops.txt .
RUN pip install --default-timeout=3600 --retries 5 --no-cache-dir -r requirements-mlops.txt

# Copy application
COPY . .

# Healthcheck
HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

EXPOSE 8001

CMD ["python", "-m", "uvicorn", "mlops.inference_service:app", "--host", "0.0.0.0", "--port", "8001"]
