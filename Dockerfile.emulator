FROM node:18-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl default-jre-headless && rm -rf /var/lib/apt/lists/*
RUN npm install -g firebase-tools
EXPOSE 4000 8080 8085 9099
HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
  CMD curl -f http://localhost:4000 || exit 1
CMD ["firebase", "emulators:start", "--project", "zilacart-local"]
